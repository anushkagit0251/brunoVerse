# BrunoVerse Environment Variables Configuration Example
# Copy this file to .env (or configure in your hosting platform)

# Backend Server & Database
PORT=8080
DATABASE_URL=jdbc:mysql://localhost:3306/brunoverse?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DATABASE_USERNAME=root
DATABASE_PASSWORD=
JWT_SECRET=brunoverse_super_secure_jwt_secret_key_minimum_32_characters_for_hmac

# Google OAuth 2.0 Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# Google Places / Maps API (Optional server-side key for nearby clinic search)
GOOGLE_MAPS_API_KEY=

# Google Gemini AI Multimodal Vision Assistant (Server-Side)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=

