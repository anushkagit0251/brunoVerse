{
  "name": "BrunoVerse – Care, Connect, Create Change",
  "short_name": "BrunoVerse",
  "description": "Report animals in need, find nearby vets and rescuers, and keep your pet's health records.",
  "start_url": "./index.html#/home",
  "scope": "./",
  "display": "standalone",
